# Frontend-safe PUBLIC configuration only.
# NEVER put GHL secrets, Firebase Admin credentials or session secrets in
# VITE_* variables — they ship in the public bundle. All GHL access goes
# through the secure server-side claim BFF.

# Base URL of the claim BFF (Phase 2). Empty = venue search shows a
# temporary-unavailable state (there is deliberately NO mock fallback).
VITE_CLAIM_API_BASE_URL=

# Back-office login URL used when a CLAIMED venue is selected and the API
# result carries no venue-specific loginUrl.
VITE_BACKOFFICE_LOGIN_URL=

# Dev-only: serve 3 clearly-labeled fixture venues instead of the API.
# Ignored in production builds.
VITE_CLAIM_DEV_STUB=

# GoHighLevel inbound webhook for lead analytics events (existing).
VITE_LEAD_WEBHOOK_URL=

# GoHighLevel calendar embed for the "Talk to us" modal (existing).
VITE_BOOKING_EMBED_URL=
